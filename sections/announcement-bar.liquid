<div class="announcement-bar" id="tultech-announcement">
  <p style="margin:0; font-weight: 500;" id="announcement-text">🔥 Nuevo en tendencia cada semana — gadgets, gafas y más.</p>
</div>

<style>
  .announcement-bar {
    background-color: var(--color-primary, #1B3C6F);
    color: #ffffff;
    text-align: center;
    padding: 10px 16px;
    font-size: 0.875rem;
    font-weight: 500;
    transition: opacity 0.3s ease-in-out;
  }
</style>

<script>
  (function() {
    function startAnnouncements() {
      const messages = [
        "🔥 Nuevo en tendencia cada semana — gadgets, gafas y más.",
        "📦 Envío estimado 15–30 días hábiles. Te avisamos si algo cambia.",
        "💬 ¿Dudas antes de comprar? Escribinos por WhatsApp — te respondemos como personas."
      ];
      
      let currentIndex = 0;
      const textElement = document.getElementById("announcement-text");
      const barElement = document.getElementById("tultech-announcement");

      if (!textElement || !barElement) return;

      setInterval(function() {
        barElement.style.opacity = 0;
        setTimeout(function() {
          currentIndex = (currentIndex + 1) % messages.length;
          textElement.textContent = messages[currentIndex];
          barElement.style.opacity = 1;
        }, 300);
      }, 2000); // 2000 ms = 2 segundos
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", startAnnouncements);
    } else {
      startAnnouncements();
    }
  })();
</script>

{% schema %}
{
  "name": "Barra de Anuncios Dinámica",
  "settings": [],
  "presets": [
    {
      "name": "Barra de Anuncios Dinámica"
    }
  ]
}
{% endschema %}
