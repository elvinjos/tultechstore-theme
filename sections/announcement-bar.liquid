<div class="announcement-bar" id="tultech-announcement">
  <p style="margin:0; font-weight: 500;" id="announcement-text">{{ section.settings.text_1 }}</p>
</div>

<style>
  .announcement-bar {
    background-color: var(--color-primary, #1B3C6F);
    color: #ffffff;
    text-align: center;
    padding: 10px 16px;
    font-size: 0.875rem;
    font-weight: 500;
    transition: opacity 0.3s ease-in-out;
  }
</style>

<script>
  (function() {
    let timer = null;

    function initAnnouncements() {
      const messages = [
        "{{ section.settings.text_1 | escape }}",
        "{{ section.settings.text_2 | escape }}",
        "{{ section.settings.text_3 | escape }}"
      ].filter(msg => msg.trim() !== "");
      
      let currentIndex = 0;
      const textElement = document.getElementById("announcement-text");
      const barElement = document.getElementById("tultech-announcement");

      if (!textElement || !barElement || messages.length <= 1) return;

      if (timer) clearInterval(timer);

      timer = setInterval(function() {
        barElement.style.opacity = 0;
        setTimeout(function() {
          currentIndex = (currentIndex + 1) % messages.length;
          textElement.textContent = messages[currentIndex];
          barElement.style.opacity = 1;
        }, 300);
      }, 2000); // 2000ms = 2 segundos
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAnnouncements);
    } else {
      initAnnouncements();
    }

    // Soporte explícito para cuando editas dentro del personalizador de Shopify
    document.addEventListener("shopify:section:load", initAnnouncements);
  })();
</script>

{% schema %}
{
  "name": "Barra de Anuncios Dinámica",
  "settings": [
    {
      "type": "text",
      "id": "text_1",
      "label": "Mensaje 1",
      "default": "🔥 Nuevo en tendencia cada semana — gadgets, gafas y más."
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Mensaje 2",
      "default": "📦 Envío estimado 15–30 días hábiles. Te avisamos si algo cambia."
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Mensaje 3",
      "default": "💬 ¿Dudas antes de comprar? Escribinos por WhatsApp — te respondemos como personas."
    }
  ],
  "presets": [
    {
      "name": "Barra de Anuncios Dinámica"
    }
  ]
}
{% endschema %}
