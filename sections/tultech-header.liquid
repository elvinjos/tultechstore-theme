<header class="site-header">
  <a href="/" class="logo">TulTech Store</a>
  <nav>
    <ul class="nav-links">
      <li><a href="/collections/all">Catálogo</a></li>
      <li><a href="/collections/tendencia-gadgets">Tendencia</a></li>
      <li><a href="/collections/repuestos-computadora">Repuestos</a></li>
      <li><a href="/pages/about-us">Sobre Nosotros</a></li>
      <li><a href="/pages/contact">Contacto</a></li>
    </ul>
  </nav>
  <div class="header-actions">
    {% if shop.customer_accounts_enabled %}
      {% if customer %}
        <a href="/account">Mi Cuenta</a>
      {% else %}
        <a href="/account/login">Ingresar</a>
      {% endif %}
    {% endif %}
    <a href="/cart" class="tultech-btn" style="padding: 0.5rem 1rem; margin-left:1rem;">Carrito</a>
  </div>
</header>

{% schema %}
{
  "name": "Encabezado (Header)",
  "settings": []
}
{% endschema %}
