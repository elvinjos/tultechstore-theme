<section class="hero-section">
  <h1>{{ section.settings.heading }}</h1>
  <p>{{ section.settings.subheading }}</p>
  <a href="{{ section.settings.button_link }}" class="tultech-btn">{{ section.settings.button_text }}</a>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título Principal",
      "default": "Lo que ves es lo que llega. Siempre."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Tecnología en tendencia, accesorios y repuestos que en tu país cuestan el doble o simplemente no se consiguen — con fotos reales y comunicación honesta."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto del Botón",
      "default": "Ver catálogo completo"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
